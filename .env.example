APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=salesdock
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=laravel_sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME="SalesDock"
ZEPTOMAIL_REVIEW_EMAIL=

TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=default

# Google Analytics 4 (prefer Admin → Settings → Analytics). Example: G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=

# Zoho SalesIQ WhatsApp (prefer Admin → Settings → WhatsApp). Bootstrap fallbacks only.
ZOHO_WHATSAPP_ENABLED=false
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_SALESIQ_URL=https://salesiq.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SALESIQ_SCREEN_NAME=
ZOHO_SALESIQ_APP_ID=
ZOHO_SALESIQ_DEPARTMENT_ID=
ZOHO_WA_OTP_TEMPLATE_ID=
ZOHO_WA_RESTOCK_TEMPLATE_ID=
ZOHO_WA_PO_TEMPLATE_ID=

# Payments: prefer Admin → Settings → Payments in the app. These env values are bootstrap fallbacks only.
# PAYMENT_PROVIDER=flutterwave|paystack
# PAYMENT_PLATFORM_SPLIT is SalesDock's share of each storefront card payment (0.015 = 1.5%).
PAYMENT_PROVIDER=flutterwave
PAYMENT_PLATFORM_SPLIT=0.015
# Flutterwave webhooks: https://your-domain/billing/webhook
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Paystack webhooks: https://your-domain/billing/webhook/paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

SCHEDULER_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (bot check on login, signup, password reset, checkout). Leave the keys blank to switch it off.
# Local: use Cloudflare always-pass test keys (live keys return error 110200 on localhost).
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Production: your real widget keys from the Cloudflare Turnstile dashboard.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional. Local: localhost,127.0.0.1  Production: salesdock.ng,www.salesdock.ng,test.salesdock.ng
TURNSTILE_HOSTNAMES=
